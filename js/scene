/* Hero 3D layer: floating chocolate pieces, ribbons and sparkles (Three.js).
   This is decoration only; the bouquet itself is your real photo.
   If WebGL or the CDN is unavailable the page works fine without it. */
import * as THREE from "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js";

const canvas = document.getElementById("scene");
const hero = canvas && canvas.closest(".hero");
const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

(function start() {
  if (!canvas) return;
  const mobile = window.matchMedia("(max-width: 900px)").matches;
  let renderer;
  try {
    renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: !mobile, powerPreference: "low-power" });
  } catch (e) { return; }
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, mobile ? 1.5 : 2));

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
  camera.position.set(0, 0, 14);

  scene.add(new THREE.AmbientLight(0xffe9dc, 0.9));
  const key = new THREE.DirectionalLight(0xfff1dd, 1.6); key.position.set(4, 6, 8); scene.add(key);
  const rim = new THREE.PointLight(0xf3a6bb, 40, 40); rim.position.set(-6, -2, 6); scene.add(rim);

  /* rounded chocolate bar shape */
  function barGeo(w, h, d, r) {
    const s = new THREE.Shape();
    const x = -w / 2, y = -h / 2;
    s.moveTo(x + r, y); s.lineTo(x + w - r, y); s.quadraticCurveTo(x + w, y, x + w, y + r);
    s.lineTo(x + w, y + h - r); s.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    s.lineTo(x + r, y + h); s.quadraticCurveTo(x, y + h, x, y + h - r);
    s.lineTo(x, y + r); s.quadraticCurveTo(x, y, x + r, y);
    const g = new THREE.ExtrudeGeometry(s, { depth: d, bevelEnabled: true, bevelThickness: 0.06, bevelSize: 0.06, bevelSegments: 2 });
    g.center(); return g;
  }
  const mats = [
    new THREE.MeshStandardMaterial({ color: 0x4a2a1e, roughness: 0.32, metalness: 0.12 }),
    new THREE.MeshStandardMaterial({ color: 0x6a3d2c, roughness: 0.4, metalness: 0.1 }),
    new THREE.MeshStandardMaterial({ color: 0xc9a15b, roughness: 0.25, metalness: 0.85 }),
    new THREE.MeshStandardMaterial({ color: 0xe58aa5, roughness: 0.35, metalness: 0.2 })
  ];
  const geos = [barGeo(1.1, 0.75, 0.35, 0.14), barGeo(0.8, 0.8, 0.4, 0.2), new THREE.SphereGeometry(0.34, 20, 16)];

  const items = [];
  const COUNT = mobile ? 9 : 16;
  for (let i = 0; i < COUNT; i++) {
    const m = new THREE.Mesh(geos[i % 3], mats[i % 4]);
    const side = i % 2 ? 1 : -1;
    m.position.set(side * (3.5 + Math.random() * 6), (Math.random() - 0.5) * 9, -2 + Math.random() * 4);
    m.rotation.set(Math.random() * 3, Math.random() * 3, Math.random() * 3);
    m.userData = { sp: 0.15 + Math.random() * 0.35, ph: Math.random() * 6.28, base: m.position.clone(), s: 0.7 + Math.random() * 0.8 };
    m.scale.setScalar(m.userData.s);
    scene.add(m); items.push(m);
  }

  /* ribbons */
  const ribbonMat = new THREE.MeshStandardMaterial({ color: 0xe58aa5, roughness: 0.3, metalness: 0.25, side: THREE.DoubleSide });
  const ribbons = [];
  for (let r = 0; r < (mobile ? 2 : 3); r++) {
    const pts = [];
    for (let i = 0; i < 8; i++) pts.push(new THREE.Vector3(-9 + i * 2.6, Math.sin(i * 0.9 + r) * 1.4 + (r - 1) * 3, -3 + Math.cos(i + r) * 0.8));
    const curve = new THREE.CatmullRomCurve3(pts);
    const mesh = new THREE.Mesh(new THREE.TubeGeometry(curve, 80, 0.07, 6, false), ribbonMat);
    mesh.userData = { r };
    scene.add(mesh); ribbons.push(mesh);
  }

  /* sparkles */
  const tex = (function () {
    const c = document.createElement("canvas"); c.width = c.height = 64;
    const g = c.getContext("2d"); const gr = g.createRadialGradient(32, 32, 0, 32, 32, 32);
    gr.addColorStop(0, "rgba(255,240,200,1)"); gr.addColorStop(0.3, "rgba(230,203,146,.8)"); gr.addColorStop(1, "rgba(230,203,146,0)");
    g.fillStyle = gr; g.fillRect(0, 0, 64, 64); return new THREE.CanvasTexture(c);
  })();
  const N = mobile ? 40 : 90, pos = new Float32Array(N * 3);
  for (let i = 0; i < N; i++) { pos[i * 3] = (Math.random() - 0.5) * 22; pos[i * 3 + 1] = (Math.random() - 0.5) * 12; pos[i * 3 + 2] = (Math.random() - 0.5) * 8; }
  const pg = new THREE.BufferGeometry(); pg.setAttribute("position", new THREE.BufferAttribute(pos, 3));
  const sparkles = new THREE.Points(pg, new THREE.PointsMaterial({ size: 0.28, map: tex, transparent: true, depthWrite: false, blending: THREE.AdditiveBlending }));
  scene.add(sparkles);

  function resize() {
    const w = hero.clientWidth, h = hero.clientHeight;
    renderer.setSize(w, h, false); camera.aspect = w / h; camera.updateProjectionMatrix();
  }
  resize(); window.addEventListener("resize", resize);

  let mx = 0, my = 0, tx = 0, ty = 0, visible = true, raf = 0;
  hero.addEventListener("pointermove", (e) => { mx = e.clientX / window.innerWidth - 0.5; my = e.clientY / window.innerHeight - 0.5; });
  new IntersectionObserver((en) => { visible = en[0].isIntersecting; if (visible && !reduce) loop(); }).observe(hero);

  const clock = new THREE.Clock();
  function frame() {
    const t = clock.getElapsedTime();
    items.forEach((m) => {
      const u = m.userData;
      m.position.y = u.base.y + Math.sin(t * u.sp * 2 + u.ph) * 0.6;
      m.rotation.x += 0.003 + u.sp * 0.004; m.rotation.y += 0.004 + u.sp * 0.004;
    });
    ribbons.forEach((r) => { r.rotation.z = Math.sin(t * 0.25 + r.userData.r) * 0.06; r.position.y = Math.sin(t * 0.4 + r.userData.r) * 0.35; });
    sparkles.rotation.y = t * 0.02; sparkles.material.opacity = 0.7 + Math.sin(t * 2) * 0.3;
    tx += (mx - tx) * 0.04; ty += (my - ty) * 0.04;
    camera.position.x = tx * 2; camera.position.y = -ty * 1.4; camera.lookAt(0, 0, 0);
    /* drift toward camera as the page scrolls */
    camera.position.z = 14 - Math.min(window.scrollY / window.innerHeight, 1) * 3;
    renderer.render(scene, camera);
  }
  function loop() { cancelAnimationFrame(raf); if (!visible || document.hidden) return; frame(); raf = requestAnimationFrame(loop); }
  document.addEventListener("visibilitychange", () => { if (!document.hidden && visible && !reduce) loop(); });
  if (reduce) frame(); else loop();
})();
